--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
@@ -7145,8 +7145,23 @@ static int stmmac_napi_poll_rxtx(struct napi_struct *napi, int budget)
 static void stmmac_tx_timeout(struct net_device *dev, unsigned int txqueue)
 {
 	struct stmmac_priv *priv = netdev_priv(dev);
-	stmmac_global_err(priv);
+
+	/*
+	 * [完美修复 Patch 1] 降级 Reset 范围，防止 page_pool 内存死锁。
+	 * 优先尝试仅重置超时的 TX 队列 (stmmac_tx_err)，保留 RX 链路和 page_pool。
+	 * 这能避免全局 Reset 时因 DSA/网桥持有 SKB 引用导致的 page_pool 异步销毁死锁。
+	 */
+	netdev_warn(dev, "TX Timeout on queue %u, attempting queue-level recovery\n", txqueue);
+	stmmac_tx_err(priv, txqueue);
+
+	/* 如果队列级恢复失败（队列依然处于 stopped 状态），说明硬件彻底挂死，再回退到全局 Reset */
+	if (netif_tx_queue_stopped(netdev_get_tx_queue(dev, txqueue))) {
+		netdev_err(dev, "Queue-level recovery failed, fallback to global reset\n");
+		stmmac_global_err(priv);
+	}
 }
 
 /**
@@ -4235,8 +4250,16 @@ static void __free_dma_rx_desc_resources(struct stmmac_priv *priv,
 	kfree(rx_q->buf_pool);
 
 	if (rx_q->page_pool)
-		page_pool_destroy(rx_q->page_pool);
+	{
+		/* 
+		 * [完美修复 Patch 2] 强制等待网络栈 (如 DSA Tagger, Bridge, Flow Offloading) 
+		 * 释放所有可能残留的 SKB 引用，防止 page_pool 异步销毁死锁 (stalled pool shutdown)。
+		 */
+		rcu_barrier();
+		msleep(100);
+		page_pool_destroy(rx_q->page_pool);
+	}
 }
 
